{
  "expo": {
    "name": "Ideafy",
    "slug": "Ideafy",
    "version": "1.0.0",
    "orientation": "portrait",

    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#141517"
    },

    "android": {
      "edgeToEdgeEnabled": true
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#141517"
        }
      ]
    ]
  }
}
