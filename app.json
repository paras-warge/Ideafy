{
  "expo": {
    "name": "Ideafy",
    "slug": "ideafy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#141517"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paraswarge.ideafy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.paras_2216.ideafy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#141517"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },

    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Ideafy to access your media.",
          "savePhotosPermission": "Allow Ideafy to save videos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],

    "owner": "parass1604",

    "extra": {
      "eas": {
        "projectId": "9d3341f5-1b13-4ada-ae99-bdedb2e65c8c"
      }
    }
  }
}